# ─────────────────────────────────────────────────────────────────────────
# KL Renovator — environment variables
#
# Copy to `.env.local` for local development, and set the same keys in
# Vercel → Project → Settings → Environment Variables for production.
# `.env*.local` is git-ignored — never commit real secrets.
#
# The site builds and runs with ALL of these missing: bookings fall back to
# WhatsApp, reviews fall back to the curated list in config/reviews.ts, and
# the admin area refuses to log anyone in (fail closed).
# ─────────────────────────────────────────────────────────────────────────

# ── Admin area (/admin/bookings) ─────────────────────────────────────────
# REQUIRED for the admin booking portal to work at all.
# The password used to be hardcoded in components/admin-auth.tsx; it is now
# checked server-side against ADMIN_PASSWORD.
# Generate a secret with:  openssl rand -hex 32
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ── Supabase (booking storage) ───────────────────────────────────────────
# Without these, /api/bookings cannot persist and the booking page is
# effectively read-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Calendar (technician scheduling) ──────────────────────────────
# Service-account credentials. Share the target calendar with the service
# account email, giving it "Make changes to events".
# GOOGLE_PRIVATE_KEY: paste the whole key in quotes, keeping the \n escapes.
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=

# ── Google Places (live Google reviews) ──────────────────────────────────
# Optional. If unset, /api/google-reviews returns 204 and the site uses the
# curated reviews in config/reviews.ts.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# ── IndexNow (Bing / Yandex ping) ────────────────────────────────────────
# Required to enable /api/indexnow. The endpoint fails closed when this is
# absent; invoke it with ?key=<value> from a trusted automation workflow.
INDEXNOW_TRIGGER_SECRET=

# ── Shared rate limiting (recommended for production) ─────────────────────
# Create a Redis database at https://upstash.com and set these server-only
# REST credentials. When omitted, development uses a bounded per-instance
# fallback; production should configure both values for global limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
