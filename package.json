{
  "name": "klrenovator",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "overrides": {
    "sharp": "0.35.3",
    "postcss": "8.5.24"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "npm run gen:site-public",
    "build": "NODE_OPTIONS='--max-old-space-size=4096' next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "gen:site-public": "tsx scripts/gen-site-public.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "verify:sanitizer": "tsx scripts/verify-sanitizer.mjs",
    "audit:gsc": "node scripts/gsc-audit.mjs",
    "bundle-analyze": "ANALYZE=true NODE_OPTIONS='--max-old-space-size=4096' next build",
    "verify:routes": "node scripts/verify-route-contracts.mjs",
    "crawl:deployed": "node scripts/crawl-deployed.mjs"
  },
  "dependencies": {
    "@googleapis/calendar": "^16.0.0",
    "@heroui/styles": "3.0.3",
    "@supabase/supabase-js": "^2.109.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "2.1.1",
    "framer-motion": "^12.42.2",
    "next": "16.2.12",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.6.0",
    "sanitize-html": "^2.17.6",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@eslint/compat": "1.2.8",
    "@eslint/eslintrc": "3.3.6",
    "@eslint/js": "9.39.5",
    "@next/bundle-analyzer": "16.2.12",
    "@next/eslint-plugin-next": "16.2.12",
    "@tailwindcss/postcss": "4.1.11",
    "@types/node": "22.20.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "10.1.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-unused-imports": "4.1.4",
    "globals": "16.0.0",
    "postcss": "8.5.24",
    "prettier": "3.5.3",
    "tailwind-variants": "3.2.2",
    "tailwindcss": "4.1.11",
    "tsx": "^4.23.12",
    "typescript": "5.9.3"
  }
}
